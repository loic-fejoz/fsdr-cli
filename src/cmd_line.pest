WHITESPACE = _{ " " | "\t" | "\r" | "\n" }

engineer_number = @{ "-"? ~ ASCII_DIGIT+ ~ ( "_" ~ ASCII_DIGIT+)* ~ (("." | ^"K" | ^"M" | ^"G" ) ~ ("_"? ~ ASCII_DIGIT)*)?  }
scientific_number = @{ "-"? ~ ASCII_DIGIT+ ~ ("." ~ ASCII_DIGIT*)? ~ "e" ~ "-"? ~ ASCII_DIGIT+ }
number = {scientific_number | engineer_number }
ident = @{ ASCII_ALPHA ~ (ASCII_ALPHANUMERIC | "_")* }
func_call = { ident ~ "(" ~ expr ~ ( "," ~ expr )* ~ ")" }
term = { "(" ~ expr ~ ")" | number | func_call | ident }
expr4 = { (minus ~ term) | term }
exponentiation = { "**" | "^" }
expr3 = { expr4 ~ (exponentiation ~  expr4)*}
multiply = { "*" }
division = { "/" }
modulus = { "%" }
expr2 = { expr3 ~ ( multiply ~ expr3 | division ~ expr3 | modulus ~ expr3 )* }
addition = { "+" }
minus = { "-" }
expr1 = { expr2 ~ (addition ~ expr2 | minus ~ expr2)* }
expr =  _{ expr1 }
number_or_paren_expr = _{  number | ( "(" ~ expr ~ ")" ) }

convert_typed = @{ ^"u8_f" | ^"s8_f" | ^"s16_f" | ^"f_u8" | ^"f_s8" | ^"f_s16" | ^"ff_c" }
bigendian = { "--bigendian" }

agc_ref_param = { ^"--reference" ~ number_or_paren_expr }
agc_max_param = { ^"--max" ~ number_or_paren_expr }
agc_rate_param = { ^"--rate" ~ number_or_paren_expr }
agc_cmd = { "agc_ff" ~ (agc_rate_param | agc_ref_param | agc_max_param)* }
amdemod_cmd = { "amdemod_cf" }
audio_cmd = { "audio" ~ number_or_paren_expr ~ number_or_paren_expr? }
bandpass_fir_fft_cc_cmd = { "bandpass_fir_fft_cc" ~ number_or_paren_expr ~ number_or_paren_expr ~ number_or_paren_expr ~ ident? }
binary_slicer_cmd = { "binary_slicer_f_u8" }
clipdetect_cmd = { "clipdetect_ff" }
convert_cmd = { "convert_" ~ convert_typed ~ bigendian? }
deemphasis_nfm_cmd = { "deemphasis_nfm_ff" ~ number_or_paren_expr }
deemphasis_wfm_cmd = { "deemphasis_wfm_ff" ~ number_or_paren_expr ~ number_or_paren_expr }
dsb_cmd = { "dsb_fc" }
dump_cmd = { "dump_f" | "dump_u8" | "dump_c" }
eval_cmd = { "=" ~ expr }
fastdcblock_cmd = { "fastdcblock_ff" }
fir_decimate_cmd = { "fir_decimate_cc" ~ number_or_paren_expr ~ (number_or_paren_expr ~ ident?)? }
fmdemod_quadri_cmd = { "fmdemod_quadri_cf" }
fmdemod_atan_cmd = { "fmdemod_atan_cf" }
fractional_decimator_cmd = { "fractional_decimator_ff" ~ number_or_paren_expr }
gain_cmd = { "gain_ff" ~ number_or_paren_expr }
load_param = { filepath }
load_types = { "f" | "u8" | "c" }
load_cmd = { "load_" ~ load_types ~ load_param }
load_kiss_cmd = { "load_kiss" ~ load_param }
save_kiss_cmd = { "save_kiss" ~ load_param }
tcp_kiss_server_cmd = { "tcp_kiss_server" ~ filepath }
tcp_kiss_client_cmd = { "tcp_kiss_client" ~ filepath }
fixedlen_to_pdu_cmd = { "fixedlen_to_pdu" ~ number_or_paren_expr ~ ident? }
limit_cmd = {"limit_ff" ~ number_or_paren_expr? }
octave_complex_cmd = { "octave_complex_c" ~ number_or_paren_expr ~ number_or_paren_expr }
pack_bits_cmd = { "pack_bits_8to1_u8_u8" | "pack_bits_1to8_u8_u8" }
pattern_search_cmd = { "pattern_search_u8_u8" ~ number_or_paren_expr ~ number_or_paren_expr+ }
resampler_types = { "ff" | "cc" }
rational_resampler_cmd = { "rational_resampler_" ~ resampler_types ~ number_or_paren_expr ~ number_or_paren_expr ~ (number_or_paren_expr ~ ident?)? }
realpart_cmd = {"realpart_cf"}
shift_addition_cmd = { "shift_addition_cc" ~ number_or_paren_expr }
timing_recovery_cmd = { "timing_recovery_cc" ~ ident ~ number_or_paren_expr ~ number_or_paren_expr ~ number_or_paren_expr }
throttle_cmd = { "throttle_cc" | "throttle_ff" }
flowcontrol_cmd = { "flowcontrol" ~ number_or_paren_expr ~ number_or_paren_expr? }
clone_cmd = { "clone" | "through" }
none_cmd = { "none" }
repeat_u8_cmd = { ("repeat_u8" | "repeat") ~ number_or_paren_expr }
weaver_lsb_cmd = { "weaver_lsb_cf" ~ number_or_paren_expr }
weaver_usb_cmd = { "weaver_usb_cf" ~ number_or_paren_expr }
cat_server_port_param = { ^"--port" ~ number_or_paren_expr }
cat_server_rx_freq_param = { ^"--rx_freq" ~ number_or_paren_expr }
cat_server_tx_freq_param = { ^"--tx_freq" ~ number_or_paren_expr }
cat_server_ctcss_tone_param = { ^"--ctcss_tone" ~ number_or_paren_expr }
cat_server_cmd = { "cat_server" ~ (cat_server_port_param | cat_server_rx_freq_param | cat_server_tx_freq_param | cat_server_ctcss_tone_param)* }
ctcss_gen_cmd = { "ctcss_gen" ~ number_or_paren_expr? }
fft_opt_flag = { ^"--octave" | ^"--benchmark" }
fft_cc_cmd = { ("fft_cc" | "fft") ~ number_or_paren_expr ~ number_or_paren_expr ~ ident? ~ fft_opt_flag* }
fft_fc_cmd = { "fft_fc" ~ number_or_paren_expr ~ number_or_paren_expr ~ ident? ~ fft_opt_flag* }
logpower_add_db_flag = { (^"--add_db=" | ^"--add_db" | ^"-a") ~ number_or_paren_expr }
logpower_cf_cmd = { ("logpower_cf" | "logpower") ~ (logpower_add_db_flag | number_or_paren_expr)? }
logavg_add_db_flag = { (^"--add=" | ^"--add" | ^"-a") ~ number_or_paren_expr }
logaveragepower_cf_cmd = { ("logaveragepower_cf" | "logaveragepower") ~ number_or_paren_expr ~ number_or_paren_expr ~ (logavg_add_db_flag | number_or_paren_expr)? }
fft_exchange_sides_ff_cmd = { ("fft_exchange_sides_ff" | "fftswap") ~ number_or_paren_expr }
dcblock_cmd = { ("dcblock_ff" | "dcblock") ~ number_or_paren_expr? }
decimating_shift_addition_cmd = { "decimating_shift_addition_cc" ~ number_or_paren_expr ~ number_or_paren_expr }
add_dcoffset_cc_cmd = { ("add_dcoffset_cc" | "add_dcoffset") ~ number_or_paren_expr? ~ number_or_paren_expr? }
mono2stereo_s16_cmd = { "mono2stereo_s16" | "mono2stereo" }
dbpsk_cmd = { "dbpsk_decoder_c_u8" | "dbpskdecoder" | "dbpskdecode" }
psk31_varicode_decoder_cmd = { "psk31_varicode_decoder_u8_u8" | "varicodedecode" }
psk31_varicode_encoder_cmd = { "psk31_varicode_encoder_u8_u8" | "varicodeencode" }
bpsk_costas_loop_cmd = { ("bpsk_costas_loop_cc" | "costas_loop_cc") ~ number_or_paren_expr? ~ number_or_paren_expr? }
pll_cmd = { "pll_cc" ~ number_or_paren_expr? ~ number_or_paren_expr? }
fmmod_fc_cmd = { "fmmod_fc" | "fmmod" }
fixed_amplitude_cc_cmd = { ("fixed_amplitude_cc" | "fixed_amplitude") ~ number_or_paren_expr? }
add_const_cc_cmd = { ("add_const_cc" | "add_const") ~ number_or_paren_expr? ~ number_or_paren_expr? }
differential_encoder_u8_u8_cmd = { "differential_encoder_u8_u8" }
differential_decoder_u8_u8_cmd = { "differential_decoder_u8_u8" }
invert_u8_u8_cmd = { "invert_u8_u8" }
bfsk_demod_cf_cmd = { "bfsk_demod_cf" | "bfskdemod" }
detect_nan_ff_cmd = { "detect_nan_ff" }
yes_f_cmd = { "yes_f" ~ number_or_paren_expr? }

any_csdr_cmd = _{ "csdr"? ~ (add_const_cc_cmd | add_dcoffset_cc_cmd | agc_cmd | amdemod_cmd | audio_cmd | bandpass_fir_fft_cc_cmd | bfsk_demod_cf_cmd | binary_slicer_cmd | bpsk_costas_loop_cmd | cat_server_cmd | clone_cmd | ctcss_gen_cmd | clipdetect_cmd | convert_cmd | dbpsk_cmd | dcblock_cmd | decimating_shift_addition_cmd | deemphasis_nfm_cmd | deemphasis_wfm_cmd | detect_nan_ff_cmd | differential_encoder_u8_u8_cmd | differential_decoder_u8_u8_cmd | dsb_cmd | dump_cmd | eval_cmd | fastdcblock_cmd | fft_cc_cmd | fft_fc_cmd | fft_exchange_sides_ff_cmd | fir_decimate_cmd | fixed_amplitude_cc_cmd | flowcontrol_cmd | fmdemod_atan_cmd | fmdemod_quadri_cmd | fmmod_fc_cmd | fractional_decimator_cmd | gain_cmd | invert_u8_u8_cmd | limit_cmd | load_cmd | load_kiss_cmd | logaveragepower_cf_cmd | logpower_cf_cmd | mono2stereo_s16_cmd | none_cmd | octave_complex_cmd | pack_bits_cmd | pattern_search_cmd | pll_cmd | psk31_varicode_decoder_cmd | psk31_varicode_encoder_cmd | rational_resampler_cmd | realpart_cmd | repeat_u8_cmd | save_kiss_cmd | shift_addition_cmd | tcp_kiss_client_cmd | tcp_kiss_server_cmd | fixedlen_to_pdu_cmd | throttle_cmd | timing_recovery_cmd | weaver_lsb_cmd | weaver_usb_cmd | yes_f_cmd) }



cmd_sep = _{ "|" | "!" }
csdr_save_opt = { ("--output" | "-o") ~ filepath }
csdr_cmd = { "csdr" ~ csdr_save_opt? ~ (cmd_sep? ~ any_csdr_cmd)+ }

not_space =  { !( " " | "\t" ) ~ ANY }
filepath = @{ not_space+ }

iqengine_cmd = { "iqengine" ~ filepath? }
grc_cmd = { "grc" ~ filepath }
help_cmd = { "--help" }

main = _{ SOI ~ (help_cmd | iqengine_cmd | grc_cmd | csdr_cmd | any_csdr_cmd)   ~ EOI }
